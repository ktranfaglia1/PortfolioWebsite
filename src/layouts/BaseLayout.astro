---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "@fontsource/instrument-serif/latin-400-italic.css";
import "../styles/global.css";
// Preloaded so text renders in the final font on first paint (no reflow/CLS).
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import geistMonoLatin from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";
import { canonicalUrl, formatTitle } from "../lib/seo";
import { OG_SIZE, ogImagePath } from "../lib/og";
import { buildPaletteItems } from "../lib/palette";
import { getPage, getProjectsWithPages } from "../lib/content";
import { site } from "../site.config";

interface Props {
  /** Page title; " | Kyle Tranfaglia" is appended unless it already names Kyle. */
  title: string;
  description: string;
  /** Keep the page out of search results (e.g. the style guide). */
  noindex?: boolean;
  /** Open Graph type: "article" for case studies. */
  ogType?: "website" | "article";
  /** Path to the share image; defaults to the generated /og/<route>.png. */
  ogImage?: string;
  /** Structured data (schema.org) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  ogType = "website",
  jsonLd,
} = Astro.props;

const fullTitle = formatTitle(title);
const canonical = canonicalUrl(Astro.url.pathname, site.url);
// Pages without their own card (404, style guide) share the home image.
const hasOwnImage = !noindex;
const ogImage = new URL(
  Astro.props.ogImage ?? ogImagePath(hasOwnImage ? Astro.url.pathname : "/"),
  site.url,
).href;

const otherPage = await getPage("experience-other");
const paletteItems = buildPaletteItems({
  nav: site.nav,
  extraPages: [
    { label: otherPage.heading, href: "/experience/other", hint: "Experience" },
  ],
  projects: (await getProjectsWithPages()).map((p) => ({
    id: p.id,
    title: p.data.title,
    stack: p.data.stack,
  })),
  email: site.email,
  resume: site.files.resume,
  transcript: site.files.transcript,
  socials: site.socials,
});
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonical} />
    )}
    <link
      rel="preload"
      href={geistLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={geistMonoLatin}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={site.name} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta
      name="theme-color"
      content="#0b0c0f"
      media="(prefers-color-scheme: dark)"
    />
    <meta
      name="theme-color"
      content="#fafafb"
      media="(prefers-color-scheme: light)"
    />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <!-- Open Graph / Twitter (LinkedIn, Slack, iMessage, X previews) -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(OG_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_SIZE.height)} />
    <meta property="og:image:alt" content={`${fullTitle}: ${site.headline}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replaceAll("<", "\\u003c")}
      />
    )}
    {site.cloudflareAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({
          token: site.cloudflareAnalyticsToken,
        })}
      />
    )}

    <!--
      Apply the theme before first paint (no flash). A choice saved by the
      toggle wins; otherwise follow the OS setting (dark if none).
      Keep the storage key in sync with src/scripts/theme.ts.
    -->
    <script is:inline>
      (() => {
        let theme = matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch {
          // Storage unavailable (private mode, blocked site data): use the OS setting.
        }
        document.documentElement.dataset.theme = theme;
        // Scroll reveals only when motion is OK (see src/scripts/reveal.ts).
        if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
          document.documentElement.classList.add("reveal");
        }
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-accent px-4 py-2 font-medium text-accent-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
    <script
      type="application/json"
      id="palette-data"
      set:html={JSON.stringify(paletteItems).replaceAll("<", "\\u003c")}
    />
    <script>
      import { site } from "../site.config";
      import { initCommandPalette } from "../scripts/command-palette";
      import { initEasterEgg } from "../scripts/easter-egg";
      import { initReveal } from "../scripts/reveal";
      import { initSpotlight } from "../scripts/spotlight";

      initCommandPalette();
      initSpotlight();
      initReveal();
      initEasterEgg(site.repo);
    </script>
  </body>
</html>
