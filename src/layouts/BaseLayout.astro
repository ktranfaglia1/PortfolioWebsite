---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";
import "../styles/global.css";
import Footer from "../components/layout/Footer.astro";
import Header from "../components/layout/Header.astro";

interface Props {
  title: string;
  description: string;
  /** Keep the page out of search results (e.g. the style guide). */
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>

    <!--
      Apply the theme before first paint (no flash). A choice saved by the
      toggle wins; otherwise follow the OS setting (dark if none).
      Keep the storage key in sync with src/scripts/theme.ts.
    -->
    <script is:inline>
      (() => {
        let theme = matchMedia("(prefers-color-scheme: light)").matches
          ? "light"
          : "dark";
        try {
          const saved = localStorage.getItem("theme");
          if (saved === "light" || saved === "dark") theme = saved;
        } catch {
          // Storage unavailable (private mode, blocked site data): use the OS setting.
        }
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-lg bg-accent px-4 py-2 font-medium text-accent-fg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
    >
      Skip to content
    </a>
    <Header />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
