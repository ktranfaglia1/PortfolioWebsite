---
import { ImageOff } from "@lucide/astro";

interface Props {
  /** What the real image will show, e.g. "Pitchfire investor dashboard". */
  label: string;
  /** CSS aspect-ratio, e.g. "16 / 9". */
  aspect?: string;
  /** "icon" renders a small square with only the icon (logos). */
  size?: "default" | "icon";
  class?: string;
}

const {
  label,
  aspect = "16 / 9",
  size = "default",
  class: className,
} = Astro.props;
---

<!-- TODO(kyle): replace with the real image when supplied. -->
<div
  role="img"
  aria-label={`Image placeholder: ${label}`}
  style={{ aspectRatio: size === "icon" ? "1 / 1" : aspect }}
  class:list={[
    "placeholder-stripes grid place-items-center border border-dashed border-line-strong",
    size === "icon" ? "size-10 shrink-0 rounded-lg" : "w-full rounded-xl",
    className,
  ]}
>
  {size === "icon" ? (
    <ImageOff size={16} class="text-fg-subtle" aria-hidden="true" />
  ) : (
    <div
      class="flex flex-col items-center gap-2 px-4 text-center"
      aria-hidden="true"
    >
      <ImageOff size={22} class="text-fg-subtle" />
      <span class="font-mono text-xs text-fg-subtle">Image coming soon</span>
      <span class="text-sm text-fg-muted">{label}</span>
    </div>
  )}
</div>

<style>
  .placeholder-stripes {
    background-color: var(--surface);
    background-image: repeating-linear-gradient(
      -45deg,
      transparent 0 10px,
      var(--surface-2) 10px 20px
    );
  }
</style>
