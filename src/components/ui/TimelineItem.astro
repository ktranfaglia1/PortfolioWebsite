---
import { formatDateRange, type EndDate } from "../../lib/dates";

interface Props {
  /** Job title, e.g. "Software Engineering Intern". */
  position: string;
  org: string;
  start: Date;
  end?: EndDate;
  location?: string;
  summary?: string;
  /** Marks the current role with an accent dot. */
  current?: boolean;
  level?: 2 | 3;
}

const {
  position,
  org,
  start,
  end,
  location,
  summary,
  current = end === "present",
  level = 3,
} = Astro.props;

const Heading = `h${level}` as "h2" | "h3";
---

<li class="relative">
  <span
    aria-hidden="true"
    class:list={[
      "absolute top-1.5 -left-[calc(1.5rem+5px)] size-2.5 rounded-full ring-4 ring-canvas sm:-left-[calc(2rem+5px)]",
      current ? "bg-accent" : "bg-line-strong",
    ]}
  ></span>
  <p class="font-mono text-xs text-fg-subtle">
    {formatDateRange(start, end)}
    {location && <span>{` · ${location}`}</span>}
  </p>
  <Heading class="mt-1.5 text-lg font-semibold">
    {position}
    <span class="font-normal text-fg-muted">{` · ${org}`}</span>
  </Heading>
  {summary && <p class="mt-2 max-w-2xl text-fg-muted">{summary}</p>}
  <div class="mt-3 max-w-2xl text-fg-muted">
    <slot />
  </div>
</li>
