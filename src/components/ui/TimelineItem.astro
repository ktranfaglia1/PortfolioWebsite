---
import { ArrowUpRight } from "@lucide/astro";
import { formatDateRange, type EndDate } from "../../lib/dates";

interface Props {
  /** Job title, e.g. "Software Engineering Intern". */
  position: string;
  org: string;
  start: Date;
  end?: EndDate;
  location?: string;
  /** Replaces the formatted date range, e.g. "Mar 2024 & Apr 2025". */
  dateLabel?: string;
  /** Links the org name (opens in a new tab). */
  orgHref?: string;
  /** Short line under the heading, e.g. what the org does. */
  orgNote?: string;
  summary?: string;
  /** Marks the current role with an accent dot. */
  current?: boolean;
  level?: 2 | 3;
}

const {
  position,
  org,
  start,
  end,
  location,
  dateLabel,
  orgHref,
  orgNote,
  summary,
  current = end === "present",
  level = 3,
} = Astro.props;

const Heading = `h${level}` as "h2" | "h3";
---

<li class="relative" data-reveal>
  <span
    aria-hidden="true"
    class:list={[
      "absolute top-1.5 -left-[calc(1.5rem+5px)] size-2.5 rounded-full ring-4 ring-canvas sm:-left-[calc(2rem+5px)]",
      current ? "bg-accent" : "bg-line-strong",
    ]}
  ></span>
  {Astro.slots.has("logo") && <slot name="logo" />}
  <p class="font-mono text-xs text-fg-subtle">
    {dateLabel ?? formatDateRange(start, end)}
    {location && <span>{` · ${location}`}</span>}
  </p>
  <Heading class="mt-1.5 text-lg font-semibold">
    {position}
    <span class="font-normal text-fg-muted">
      {" · "}
      {orgHref ? (
        <a
          href={orgHref}
          target="_blank"
          rel="noopener noreferrer"
          class="group/org inline-flex items-center gap-0.5 underline decoration-line-strong underline-offset-4 transition-colors hover:text-fg hover:decoration-accent"
        >
          {org}
          <ArrowUpRight
            size={14}
            aria-hidden="true"
            class="text-fg-subtle transition-colors group-hover/org:text-accent"
          />
          <span class="sr-only">(opens in a new tab)</span>
        </a>
      ) : (
        org
      )}
    </span>
  </Heading>
  {orgNote && <p class="mt-1 text-sm text-fg-subtle">{orgNote}</p>}
  {summary && <p class="mt-2 max-w-2xl text-fg-muted">{summary}</p>}
  <div class="mt-3 max-w-2xl text-fg-muted">
    <slot />
  </div>
</li>
