---
interface Props {
  variant?: "default" | "accent";
  class?: string;
}

const { variant = "default", class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex items-center gap-1 rounded-md px-2 py-0.5 font-mono text-xs leading-5",
    variant === "accent"
      ? "bg-accent-subtle text-accent"
      : "border border-line bg-surface-2 text-fg-muted",
    className,
  ]}
>
  <slot />
</span>
