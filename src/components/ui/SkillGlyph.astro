---
/** Generic icon for a skill without a brand mark (see `glyph` in skills.yaml). */
import {
  Axis3d,
  ChartLine,
  MessageSquareText,
  Paintbrush,
  ShieldCheck,
  TestTubeDiagonal,
  Waypoints,
} from "@lucide/astro";
import type { SkillGlyphName } from "../../lib/skill-icons";

interface Props {
  glyph: SkillGlyphName;
  size?: number;
  class?: string;
}

const { glyph, size = 16, class: className } = Astro.props;
const Icon = {
  prompt: MessageSquareText,
  embeddings: Waypoints,
  vector: Axis3d,
  chart: ChartLine,
  security: ShieldCheck,
  canvas: Paintbrush,
  testing: TestTubeDiagonal,
}[glyph];
---

<Icon size={size} aria-hidden="true" class={className} />
