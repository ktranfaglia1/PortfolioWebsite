---
import { ArrowLeft } from "@lucide/astro";
import Container from "../layout/Container.astro";
import AccentText from "../ui/AccentText.astro";
import HeroGlow from "../ui/HeroGlow.astro";

interface Props {
  heading: string;
  /** Large secondary line; *asterisks* mark the serif-italic accent. */
  headline?: string;
  intro?: string;
  /** Small mono label above the heading. */
  eyebrow?: string;
  /** A back link above the heading (e.g. /experience/other → Experience).
   *  It sits inside the header's top padding, so the heading lines up with
   *  pages that have no back link. */
  back?: { href: string; label: string };
  /** Soft violet/warm glow behind the header (default on). */
  glow?: boolean;
  /** Match the intro to the timeline's text width (pages that are one
   *  timeline, like /experience/other). */
  introWide?: boolean;
  class?: string;
}

const {
  heading,
  headline,
  intro,
  eyebrow,
  back,
  glow = true,
  introWide = false,
  class: className,
} = Astro.props;
---

<div class="relative isolate overflow-hidden">
  {glow && <HeroGlow class="opacity-80" />}
  <Container
    class:list={[
      "pb-12 sm:pb-14 xl:pb-16",
      // The back link plus its margin is 2.5rem, taken out of the top padding.
      back ? "pt-4 sm:pt-10 xl:pt-14" : "pt-14 sm:pt-20 xl:pt-24",
      className,
    ]}
  >
    {back && (
      <a
        href={back.href}
        class="mb-5 inline-flex h-5 items-center gap-1.5 rounded-md text-sm text-fg-muted transition-colors hover:text-fg"
      >
        <ArrowLeft size={16} aria-hidden="true" /> {back.label}
      </a>
    )}
    {eyebrow && (
      <p class="mb-5 font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase">
        {eyebrow}
      </p>
    )}
    <h1 class="text-[clamp(2.75rem,1.2rem+4.4vw,6.5rem)] leading-[0.95] font-semibold tracking-[-0.04em]">
      {heading}
    </h1>
    {headline && (
      <p class="mt-5 max-w-[24ch] text-[clamp(1.5rem,1rem+1.6vw,2.75rem)] leading-[1.1] font-medium tracking-[-0.02em] text-fg-muted">
        <AccentText text={headline} />
      </p>
    )}
    {intro && (
      <p
        class:list={[
          "mt-6 text-lg text-fg-muted sm:text-xl",
          introWide ? "max-w-[58rem]" : "max-w-[60ch]",
        ]}
      >
        {intro}
      </p>
    )}
    {Astro.slots.has("default") && (
      <div class="mt-10 flex flex-wrap items-center gap-3">
        <slot />
      </div>
    )}
  </Container>
</div>
