---
import { Mail } from "@lucide/astro";
import { site } from "../../site.config";
import { github, linkedin } from "../../icons/brands";
import BrandIcon from "../ui/BrandIcon.astro";
import Container from "./Container.astro";

const year = new Date().getFullYear();

const links = [
  { label: "GitHub", href: site.socials.github, brand: github },
  { label: "LinkedIn", href: site.socials.linkedin, brand: linkedin },
] as const;
---

<footer class="mt-24 border-t border-line">
  <Container class="flex flex-col gap-6 py-10 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="font-medium text-fg">{site.name}</p>
      <p class="mt-1 text-sm text-fg-subtle">{site.headline}</p>
    </div>

    <div class="flex flex-col gap-4 sm:items-end">
      <ul class="flex items-center gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex size-9 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
            >
              <BrandIcon icon={link.brand} />
              <span class="sr-only">{link.label} (opens in a new tab)</span>
            </a>
          </li>
        ))}
        <li>
          <a
            href={`mailto:${site.email}`}
            class="inline-flex size-9 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg"
          >
            <Mail size={18} aria-hidden="true" />
            <span class="sr-only">Email</span>
          </a>
        </li>
      </ul>
      <p class="font-mono text-xs text-fg-subtle">
        © {year} {site.name}
      </p>
    </div>
  </Container>
</footer>
