---
import { ArrowUpRight, Mail } from "@lucide/astro";
import { site } from "../../site.config";
import { github, linkedin } from "../../icons/brands";
import BrandIcon from "../ui/BrandIcon.astro";
import Container from "./Container.astro";

const year = new Date().getFullYear();

const iconLink =
  "inline-flex size-9 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg";

const links = [
  { label: "GitHub", href: site.socials.github, brand: github },
  { label: "LinkedIn", href: site.socials.linkedin, brand: linkedin },
] as const;
---

<footer class="mt-24 border-t border-line">
  <Container class="py-8">
    <div class="flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
      <div class="flex items-center gap-3">
        <span
          aria-hidden="true"
          class="inline-flex size-8 shrink-0 items-center justify-center rounded-lg border border-line bg-surface-2 font-mono text-xs tracking-[-0.04em] text-accent"
        >
          KT
        </span>
        <div>
          <p class="text-sm font-medium text-fg">{site.name}</p>
          <p class="text-sm text-fg-subtle">
            {`${site.headline} · ${site.location}`}
          </p>
        </div>
      </div>

      <ul class="-ml-2 flex items-center gap-1 sm:ml-0">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              class={iconLink}
            >
              <BrandIcon icon={link.brand} />
              <span class="sr-only">{link.label} (opens in a new tab)</span>
            </a>
          </li>
        ))}
        <li>
          <a href={`mailto:${site.email}`} class={iconLink}>
            <Mail size={18} aria-hidden="true" />
            <span class="sr-only">Email</span>
          </a>
        </li>
      </ul>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-x-6 gap-y-2 font-mono text-xs text-fg-subtle">
      <p>
        © {year} {site.name}
      </p>
      <a
        href={site.repo}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1 transition-colors hover:text-fg"
      >
        Site source
        <ArrowUpRight size={12} aria-hidden="true" />
        <span class="sr-only">(opens in a new tab)</span>
      </a>
    </div>
  </Container>
</footer>
