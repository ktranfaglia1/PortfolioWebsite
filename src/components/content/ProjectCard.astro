---
import { ArrowUpRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { Project } from "../../lib/content";
import { formatDateRange } from "../../lib/dates";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";
import Tag from "../ui/Tag.astro";

interface Props {
  project: Project;
  /** Heading level inside the surrounding section. */
  level?: 2 | 3;
  /** Show the cover image (featured cards). */
  showCover?: boolean;
  class?: string;
}

const { project, level = 3, showCover = true, class: className } = Astro.props;
const { title, summary, stack, cover, categories, start, end, context } =
  project.data;
const Heading = `h${level}` as "h2" | "h3";
---

<!--
  The title link is stretched over the whole card (after:inset-0), so the card
  is clickable while its accessible name stays just the title.
  data-* attributes drive the project filter on /projects.
-->
<article
  data-project
  data-categories={categories.join(" ")}
  data-stack={JSON.stringify(stack)}
  class:list={[
    "group relative flex flex-col overflow-hidden rounded-2xl border border-line bg-surface shadow-card",
    "transition-[border-color,background-color,transform] duration-200 ease-snappy",
    "focus-within:border-line-strong hover:-translate-y-0.5 hover:border-line-strong hover:bg-surface-2",
    className,
  ]}
>
  {showCover &&
    (cover ? (
      <Image
        src={cover.src}
        alt={cover.alt}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 1024px) 40vw, (min-width: 640px) 50vw, 100vw"
        class="aspect-video w-full border-b border-line object-cover object-top"
      />
    ) : (
      <ImagePlaceholder
        label={title}
        class="rounded-none border-0 border-b border-solid"
      />
    ))}
  <div class="flex flex-1 flex-col p-5 sm:p-6">
    <p class="font-mono text-xs text-fg-subtle">
      {formatDateRange(start, end)}
      {context && <span>{` · ${context}`}</span>}
    </p>
    <Heading class="mt-2 text-lg font-semibold">
      <a
        href={`/projects/${project.id}`}
        class="inline-flex items-start gap-1 rounded-sm after:absolute after:inset-0 after:content-[''] focus-visible:outline-none"
      >
        {title}
        <ArrowUpRight
          size={18}
          aria-hidden="true"
          class="mt-0.5 shrink-0 text-fg-subtle transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-hover:text-accent"
        />
      </a>
    </Heading>
    <p class="mt-2 text-fg-muted">{summary}</p>
    <ul class="mt-auto flex flex-wrap gap-1.5 pt-5" aria-label="Tech stack">
      {stack.slice(0, 5).map((t) => (
        <li>
          <Tag>{t}</Tag>
        </li>
      ))}
    </ul>
  </div>
</article>

<style>
  /* Show the focus ring on the whole card when its stretched link is focused. */
  article:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }
</style>
