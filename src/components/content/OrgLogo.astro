---
import {
  Briefcase,
  GraduationCap,
  HeartHandshake,
  Users,
  UtensilsCrossed,
} from "@lucide/astro";
import { Image } from "astro:assets";
import type { Experience } from "../../lib/content";

interface Props {
  entry: Experience;
  /** "md" for full timeline entries, "sm" for compact lists. */
  size?: "sm" | "md";
  class?: string;
}

const { entry, size = "md", class: className } = Astro.props;
const d = entry.data;

// Entries without a logo get an icon for their kind of work on that group's
// color (teaching matches its lane in the career graph), so the row keeps the
// same shape and a bit of color beside the real logos.
const Icon = {
  professional: Briefcase,
  teaching: GraduationCap,
  leadership: Users,
  volunteer: HeartHandshake,
  other: UtensilsCrossed,
}[d.group];
---

{/* Logos sit on a white tile in both themes, so marks in any color stay
     legible and every logo reads at the same size. `bleed` logos (a mark on
     its own colored square) fill the tile instead. */}
{d.orgLogo ? (
  <div
    class:list={[
      "flex shrink-0 items-center justify-center overflow-hidden border border-line bg-[white]",
      size === "md" ? "size-12 rounded-xl sm:size-14" : "size-10 rounded-lg",
      !d.orgLogo.bleed && (size === "md" ? "p-1 sm:p-1.5" : "p-1"),
      className,
    ]}
  >
    {/* Width only, so wide and tall logos keep their proportions. */}
    <Image
      src={d.orgLogo.src}
      alt={d.orgLogo.alt}
      width={128}
      class:list={[
        d.orgLogo.bleed
          ? "size-full object-cover"
          : "max-h-full max-w-full object-contain",
      ]}
    />
  </div>
) : (
  <div
    aria-hidden="true"
    class:list={[
      "flex shrink-0 items-center justify-center",
      {
        professional: "bg-accent text-accent-fg",
        teaching: "bg-warm text-[white]",
        leadership: "bg-accent text-accent-fg",
        volunteer: "bg-warm text-[white]",
        other: "bg-warm text-[white]",
      }[d.group],
      size === "md" ? "size-12 rounded-xl sm:size-14" : "size-10 rounded-lg",
      className,
    ]}
  >
    <Icon size={size === "md" ? 26 : 18} />
  </div>
)}
