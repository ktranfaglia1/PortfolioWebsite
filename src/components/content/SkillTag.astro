---
import { getSkillIcon } from "../../lib/skill-icons";
import BrandIcon from "../ui/BrandIcon.astro";
import Tag from "../ui/Tag.astro";

interface Props {
  name: string;
  /** Simple Icons slug; omitted means a plain text tag. */
  icon?: string;
}

const { name, icon } = Astro.props;
const mark = icon ? getSkillIcon(icon) : undefined;
---

<Tag>
  {mark && <BrandIcon icon={mark} size={12} />}
  {name}
</Tag>
