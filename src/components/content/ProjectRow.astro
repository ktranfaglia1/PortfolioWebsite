---
/**
 * Editorial case-study teaser: number, categories, large title, summary,
 * an outcome strip of headline figures, and the cover at its natural aspect
 * ratio (never cropped). The title link is
 * stretched over the whole row. data-* attributes drive the /projects filter.
 */
import { ArrowUpRight } from "@lucide/astro";
import { Image } from "astro:assets";
import type { Project } from "../../lib/content";
import { formatDateRange } from "../../lib/dates";
import { categoryLabels } from "../../lib/projects";
import ImagePlaceholder from "../ui/ImagePlaceholder.astro";

interface Props {
  project: Project;
  /** Position in the list, shown as "01". */
  number: number;
  level?: 2 | 3;
  /** Above the fold: eager image, no reveal fade. */
  priority?: boolean;
}

const { project, number, level = 3, priority = false } = Astro.props;
const d = project.data;
const Heading = `h${level}` as "h2" | "h3";
---

<article
  data-project
  data-reveal={priority ? undefined : ""}
  data-categories={d.categories.join(" ")}
  data-stack={JSON.stringify(d.stack)}
  class="group relative grid gap-8 border-t border-line py-12 first:border-t-0 lg:grid-cols-12 lg:gap-10 xl:py-16"
>
  <div class="lg:col-span-7 xl:col-span-6">
    <p class="flex flex-wrap items-center gap-x-3 gap-y-1 font-mono text-xs text-fg-subtle">
      <span class="text-accent">{String(number).padStart(2, "0")}</span>
      <span>{d.categories.map((c) => categoryLabels[c]).join(" · ")}</span>
    </p>
    <Heading class="mt-4 text-[clamp(2rem,1.2rem+2.6vw,3.75rem)] leading-[1] font-semibold tracking-[-0.03em]">
      <a
        href={`/projects/${project.id}`}
        class="rounded-sm transition-colors after:absolute after:inset-0 after:content-[''] group-hover:text-accent focus-visible:outline-none"
      >
        {d.title}
        <ArrowUpRight
          aria-hidden="true"
          class="ml-1 inline-block size-[0.45em] align-top text-fg-subtle transition-colors group-hover:text-accent"
        />
      </a>
    </Heading>
    <p class="mt-4 max-w-[52ch] text-lg text-fg-muted">{d.summary}</p>
    <p class="mt-4 font-mono text-xs text-fg-subtle">
      {[d.context, formatDateRange(d.start, d.end)].filter(Boolean).join(" · ")}
    </p>
    {d.outcomes.length > 0 && (
      <dl
        class:list={[
          "mt-8 grid max-w-xl gap-6 border-t border-line pt-6",
          d.outcomes.length === 4
            ? "grid-cols-2 sm:grid-cols-4"
            : "grid-cols-3",
        ]}
      >
        {d.outcomes.map((o) => (
          <div class="flex flex-col-reverse justify-end">
            <dt class="mt-2 text-xs leading-snug text-fg-subtle">{o.label}</dt>
            <dd class="text-[clamp(1.375rem,1rem+1.1vw,2.25rem)] leading-none font-semibold tracking-tight text-fg">
              {o.value}
            </dd>
          </div>
        ))}
      </dl>
    )}
  </div>
  <div class="lg:col-span-5 xl:col-span-6">
    {d.cover ? (
      <div class="overflow-hidden rounded-2xl border border-line">
        <Image
          src={d.cover.src}
          alt=""
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1280px) 46vw, (min-width: 1024px) 40vw, 100vw"
          quality={70}
          loading={priority ? "eager" : "lazy"}
          fetchpriority={priority ? "high" : "auto"}
          class="h-auto w-full transition-transform duration-500 ease-snappy group-hover:scale-[1.015] motion-reduce:transition-none"
        />
      </div>
    ) : (
      <ImagePlaceholder label={d.title} />
    )}
  </div>
</article>

<style>
  article:has(a:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 4px;
    border-radius: 0.75rem;
  }
</style>
