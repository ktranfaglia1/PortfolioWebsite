---
import { ArrowRight, Award, GraduationCap } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import CareerGraph from "../../components/content/CareerGraph.astro";
import ExperienceItem from "../../components/content/ExperienceItem.astro";
import Section from "../../components/ui/Section.astro";
import Timeline from "../../components/ui/Timeline.astro";
import { getEducation, getExperience, getPage } from "../../lib/content";
import { formatDateRange } from "../../lib/dates";

const page = await getPage("experience");
const otherPage = await getPage("experience-other");
const professional = await getExperience("professional");
const teaching = await getExperience("teaching");
const leadership = await getExperience("leadership");
const volunteer = await getExperience("volunteer");
const education = await getEducation();

const sections = [
  { id: "history", label: "History" },
  { id: "professional", label: "Professional" },
  { id: "teaching", label: "Teaching" },
  { id: "leadership", label: "Leadership" },
  { id: "education", label: "Education" },
];
const label = "font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase";
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader
    heading={page.heading}
    headline={page.headline}
    intro={page.intro}
  >
    <nav aria-label="On this page">
      <ul class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-sm">
        {sections.map((s) => (
          <li>
            <a
              href={`#${s.id}`}
              class="text-fg-muted underline-offset-4 transition-colors hover:text-fg hover:underline"
            >
              {s.label}
            </a>
          </li>
        ))}
        <li>
          <a
            href="/experience/other"
            class="text-fg-muted underline-offset-4 transition-colors hover:text-fg hover:underline"
          >
            {otherPage.heading}
          </a>
        </li>
      </ul>
    </nav>
  </PageHeader>

  <Section
    id="history"
    eyebrow="$ git log --graph"
    title="Career history"
    description="Work, teaching, projects, and school on one timeline, newest first. Each row links to its details."
    split
  >
    <CareerGraph />
  </Section>

  <Section id="professional" eyebrow="01" title="Professional" split>
    <Timeline>
      {professional.map((e) => (
        <ExperienceItem entry={e} />
      ))}
    </Timeline>
  </Section>

  <Section
    id="teaching"
    eyebrow="02"
    title="Teaching & Tutoring"
    description={`${teaching.length} roles tutoring and teaching Math and Computer Science.`}
    split
  >
    <Timeline>
      {teaching.map((e) => (
        <ExperienceItem entry={e} />
      ))}
    </Timeline>
  </Section>

  <Section id="leadership" eyebrow="03" title="Leadership & Community" split>
    <Timeline>
      {leadership.map((e) => (
        <ExperienceItem entry={e} />
      ))}
    </Timeline>
    {volunteer.length > 0 && (
      <div class="mt-14">
        <h3 class={label}>Volunteering</h3>
        <ul class="mt-4 divide-y divide-line border-y border-line">
          {volunteer.map((v) => (
            <li class="flex flex-col gap-1 py-4 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
              <p>
                <span class="font-medium text-fg">{v.data.role}</span>
                <span class="text-fg-muted">{` · ${v.data.org}`}</span>
                <span class="mt-0.5 block text-sm text-fg-muted">
                  {v.data.summary}
                </span>
              </p>
              <p class="shrink-0 font-mono text-xs text-fg-subtle">
                {v.data.dateLabel ?? formatDateRange(v.data.start, v.data.end)}
              </p>
            </li>
          ))}
        </ul>
      </div>
    )}
  </Section>

  <Section id="education" eyebrow="04" title="Education & Honors" split>
    {education.map(({ data: ed }) => (
      <div class="grid gap-12 xl:grid-cols-2">
        <div data-reveal>
          <p class="flex items-center gap-2 font-mono text-xs text-fg-subtle">
            <GraduationCap size={14} aria-hidden="true" />
            {formatDateRange(ed.start, ed.end)}
            {ed.location && <span>{` · ${ed.location}`}</span>}
          </p>
          <h3 class="mt-3 text-[clamp(1.75rem,1.2rem+1.4vw,2.5rem)] leading-tight font-semibold tracking-tight">
            {ed.school}
          </h3>
          <ul class="mt-6 space-y-4">
            {ed.degrees.map((deg) => (
              <li>
                <p class="font-medium text-fg">{deg.name}</p>
                <p class="text-sm text-fg-muted">
                  {`${deg.tracks.length > 1 ? "Tracks" : "Track"}: ${deg.tracks.join("; ")}`}
                </p>
              </li>
            ))}
            {ed.minors.length > 0 && (
              <li>
                <p class="font-medium text-fg">
                  {`Minor in ${ed.minors.join(", ")}`}
                </p>
              </li>
            )}
          </ul>
          <dl class="mt-8 grid max-w-md grid-cols-2 gap-6 border-t border-line pt-6">
            <div class="flex flex-col-reverse justify-end">
              <dt class="mt-2 text-xs text-fg-subtle">GPA</dt>
              <dd class="text-[clamp(1.5rem,1rem+1.2vw,2.25rem)] leading-none font-semibold tracking-tight text-fg">
                {ed.gpa}
              </dd>
            </div>
            {ed.distinction && (
              <div class="flex flex-col-reverse justify-end">
                <dt class="mt-2 text-xs text-fg-subtle">Distinction</dt>
                <dd class="font-serif text-[clamp(1.5rem,1rem+1.2vw,2.25rem)] leading-none text-fg italic">
                  {ed.distinction}
                </dd>
              </div>
            )}
          </dl>
        </div>

        {ed.honors.length > 0 && (
          <div>
            <h3 class:list={[label, "flex items-center gap-2"]}>
              <Award size={14} aria-hidden="true" /> Honors & awards
            </h3>
            <ul class="mt-4 divide-y divide-line border-y border-line">
              {ed.honors.map((h) => (
                <li class="py-3">
                  <p class="font-medium text-fg">{h.title}</p>
                  {(h.when || h.detail) && (
                    <p class="text-sm text-fg-muted">
                      {[h.detail, h.when].filter(Boolean).join(" · ")}
                    </p>
                  )}
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    ))}
  </Section>

  <section class="border-t border-line" aria-labelledby="other-title">
    <Container class="py-16 sm:py-20">
      <a
        href="/experience/other"
        class="group flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class={label}>Before software</p>
          <h2
            id="other-title"
            class="mt-3 text-[clamp(1.75rem,1.2rem+1.6vw,3rem)] leading-tight font-semibold tracking-tight transition-colors group-hover:text-accent"
          >
            {otherPage.heading}
          </h2>
          <p class="mt-3 max-w-[60ch] text-fg-muted">{otherPage.intro}</p>
        </div>
        <ArrowRight
          size={28}
          aria-hidden="true"
          class="shrink-0 text-fg-subtle transition-transform group-hover:translate-x-1 group-hover:text-accent"
        />
      </a>
    </Container>
  </section>
</BaseLayout>
