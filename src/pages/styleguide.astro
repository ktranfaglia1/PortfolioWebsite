---
/**
 * Design-system review page (Phase 1). Not linked from the nav, excluded from
 * the sitemap, and marked noindex. Sample copy here is for review only.
 */
import { ArrowRight, ArrowUpRight, Download } from "@lucide/astro";
import { Image } from "astro:assets";
import { getExperience, getProjects } from "../lib/content";
import { formatDateRange } from "../lib/dates";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import CareerGraph from "../components/content/CareerGraph.astro";
import ProjectRow from "../components/content/ProjectRow.astro";
import AccentText from "../components/ui/AccentText.astro";
import Button from "../components/ui/Button.astro";
import Card from "../components/ui/Card.astro";
import ImagePlaceholder from "../components/ui/ImagePlaceholder.astro";
import Section from "../components/ui/Section.astro";
import Tag from "../components/ui/Tag.astro";
import Timeline from "../components/ui/Timeline.astro";
import TimelineItem from "../components/ui/TimelineItem.astro";

const swatches = [
  { token: "canvas", className: "bg-canvas", note: "Page background" },
  { token: "surface", className: "bg-surface", note: "Cards" },
  { token: "surface-2", className: "bg-surface-2", note: "Hover, insets" },
  { token: "line", className: "bg-line", note: "Borders" },
  { token: "line-strong", className: "bg-line-strong", note: "Hover borders" },
  { token: "fg", className: "bg-fg", note: "Primary text" },
  { token: "fg-muted", className: "bg-fg-muted", note: "Body text" },
  { token: "fg-subtle", className: "bg-fg-subtle", note: "Meta text" },
  { token: "accent", className: "bg-accent", note: "Links, focus, highlights" },
  {
    token: "accent-subtle",
    className: "bg-accent-subtle",
    note: "Accent tint",
  },
  { token: "warm", className: "bg-warm", note: "Glows, live dot" },
];

const stack = [
  "TypeScript",
  "React",
  "Node.js",
  "PostgreSQL",
  "Python",
  "PyTorch",
];

// Real content (Phase 2): proves every entry, image, and reference resolves.
const projects = await getProjects();
const featured = projects.filter((p) => p.data.tier === "featured");
const professional = await getExperience("professional");
const experience = await getExperience();
const groupCounts = Object.entries(
  Object.groupBy(experience, (e) => e.data.group),
).map(([group, entries]) => ({ group, count: entries?.length ?? 0 }));
const chessBot = featured.find((p) => p.id === "transformer-chess-bot");
---

<BaseLayout
  title="Style Guide | Kyle Tranfaglia"
  description="Design system reference for the portfolio redesign."
  noindex
>
  <Container class="pt-16 pb-4 sm:pt-24">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">
      Phase 1 · Design system
    </p>
    <h1 class="mt-3 text-display font-semibold">Style Guide</h1>
    <p class="mt-4 max-w-2xl text-lg text-fg-muted">
      Every token and base component in one place. Use the theme toggle in the
      header to review light mode. This page is not linked from the site and is
      hidden from search.
    </p>
  </Container>

  <Section id="color" eyebrow="Tokens" title="Color">
    <ul class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
      {swatches.map((s) => (
        <li class="overflow-hidden rounded-xl border border-line bg-surface">
          <div class:list={["h-16 border-b border-line", s.className]} />
          <div class="p-3">
            <p class="font-mono text-xs text-fg">{s.token}</p>
            <p class="mt-0.5 text-xs text-fg-subtle">{s.note}</p>
          </div>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="type" eyebrow="Tokens" title="Typography">
    <div class="space-y-6">
      <div>
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          text-display · Geist 600
        </p>
        <p class="text-display font-semibold">Kyle Tranfaglia</p>
      </div>
      <div>
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          font-serif · Instrument Serif italic, accents only
        </p>
        <p class="font-serif text-4xl text-fg italic">AI products end to end</p>
      </div>
      <div>
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          text-3xl · section title
        </p>
        <p class="text-3xl font-semibold tracking-tight">Selected projects</p>
      </div>
      <div>
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          text-lg · card title
        </p>
        <p class="text-lg font-semibold tracking-tight">
          Transformer Chess Bot
        </p>
      </div>
      <div class="max-w-2xl">
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          text-base · fg-muted · body
        </p>
        <p class="text-fg-muted">
          Re-architected an internal Python/AWS tool into a multi-tenant,
          production TypeScript platform and expanded it from VC-only to support
          PE firms.
        </p>
      </div>
      <div>
        <p class="mb-2 font-mono text-xs text-fg-subtle">
          font-mono · meta and labels
        </p>
        <p class="font-mono text-sm text-fg-muted">
          Dec 2025 – Present · Durham, NC
        </p>
      </div>
      <p>
        Inline link:{" "}
        <a href="#type" class="text-accent underline-offset-4 hover:underline">
          view the case study
        </a>
        .
      </p>
    </div>
  </Section>

  <Section id="buttons" eyebrow="Components" title="Buttons and Tags">
    <div class="flex flex-wrap items-center gap-3">
      <Button href="#buttons">
        View projects <ArrowRight size={16} aria-hidden="true" />
      </Button>
      <Button variant="secondary" href="#buttons">
        <Download size={16} aria-hidden="true" /> Resume
      </Button>
      <Button variant="ghost">Ghost</Button>
      <Button size="sm" variant="secondary">
        Small
      </Button>
      <Button size="lg">Large</Button>
    </div>
    <div class="mt-6 flex flex-wrap gap-2">
      {stack.map((s) => (
        <Tag>{s}</Tag>
      ))}
      <Tag variant="accent">Featured</Tag>
    </div>
  </Section>

  <Section id="cards" eyebrow="Components" title="Cards">
    <div class="grid gap-4 sm:grid-cols-2">
      <Card>
        <p class="font-mono text-xs text-fg-subtle">Static card</p>
        <h3 class="mt-2 text-lg font-semibold">City of Cambridge</h3>
        <p class="mt-2 text-fg-muted">
          Python GIS application integrating LiDAR and DEM data to visualize
          FEMA flood projections.
        </p>
      </Card>
      <Card href="#cards">
        <p class="font-mono text-xs text-fg-subtle">Linked card (hover me)</p>
        <h3 class="mt-2 flex items-center gap-1 text-lg font-semibold">
          Music Painter{" "}
          <ArrowUpRight size={18} aria-hidden="true" class="text-fg-subtle" />
        </h3>
        <p class="mt-2 text-fg-muted">
          FFT-based desktop app that turns audio into images. Accepted at five
          conferences.
        </p>
      </Card>
    </div>
  </Section>

  <Section
    id="editorial"
    eyebrow="Components"
    title="Editorial Pieces"
    description="The Phase 5.5 redesign: serif-italic accents, numbered split sections, case-study rows with outcome strips, and the career graph."
  >
    <div class="space-y-16">
      <div>
        <p class="mb-3 font-mono text-xs text-fg-subtle">
          AccentText · copy marks one phrase with *asterisks*
        </p>
        <p class="max-w-[22ch] text-[clamp(1.75rem,1rem+2.4vw,3.5rem)] leading-[1.05] font-medium tracking-[-0.02em] text-fg-muted">
          <AccentText text="Software engineer building *AI products end to end*." />
        </p>
      </div>
      {chessBot && (
        <div>
          <p class="mb-3 font-mono text-xs text-fg-subtle">
            ProjectRow · home and /projects
          </p>
          <div class="border-y border-line">
            <ProjectRow project={chessBot} number={1} />
          </div>
        </div>
      )}
      <div>
        <p class="mb-3 font-mono text-xs text-fg-subtle">
          CareerGraph · /experience
        </p>
        <CareerGraph />
      </div>
    </div>
  </Section>

  <Section id="timeline" eyebrow="Components" title="Timeline">
    <Timeline>
      {professional.map((e) => (
        <TimelineItem
          position={e.data.role}
          org={e.data.org}
          start={e.data.start}
          end={e.data.end}
          location={e.data.location}
          summary={e.data.summary}
        >
          {e.data.highlights.length > 0 && (
            <ul class="list-disc space-y-1.5 pl-5 marker:text-fg-subtle">
              {e.data.highlights.slice(0, 3).map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </TimelineItem>
      ))}
    </Timeline>
  </Section>

  <Section
    id="content"
    eyebrow="Phase 2"
    title="Content Inventory"
    description="Every project in src/content, rendered from the validated collections, plus experience counts by group. Archive projects have no cover by design."
  >
    <div class="relative overflow-x-auto rounded-2xl border border-line">
      <table class="w-full min-w-xl text-left text-sm">
        <caption class="sr-only">Projects</caption>
        <thead class="bg-surface-2 font-mono text-xs text-fg-subtle">
          <tr>
            <th scope="col" class="px-4 py-3 font-normal">
              Cover
            </th>
            <th scope="col" class="px-4 py-3 font-normal">
              Project
            </th>
            <th scope="col" class="px-4 py-3 font-normal">
              Tier
            </th>
            <th scope="col" class="px-4 py-3 font-normal">
              Dates
            </th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line">
          {projects.map((p) => (
            <tr>
              <td class="w-28 px-4 py-3">
                {p.data.cover ? (
                  <Image
                    src={p.data.cover.src}
                    alt=""
                    width={96}
                    class="aspect-video w-24 rounded-md border border-line object-cover object-top"
                  />
                ) : (
                  <span class="font-mono text-xs text-fg-subtle">none</span>
                )}
              </td>
              <td class="px-4 py-3">
                <p class="font-medium text-fg">{p.data.title}</p>
                <p class="mt-0.5 text-fg-muted">{p.data.summary}</p>
              </td>
              <td class="px-4 py-3">
                <Tag
                  variant={p.data.tier === "featured" ? "accent" : "default"}
                >
                  {p.data.tier}
                </Tag>
              </td>
              <td class="px-4 py-3 font-mono text-xs whitespace-nowrap text-fg-subtle">
                {formatDateRange(p.data.start, p.data.end)}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <ul class="mt-6 flex flex-wrap gap-2">
      {groupCounts.map(({ group, count }) => (
        <li>
          <Tag>{`${group}: ${count}`}</Tag>
        </li>
      ))}
    </ul>
  </Section>

  <Section id="placeholder" eyebrow="Components" title="Image Placeholder">
    <div class="grid gap-4 sm:grid-cols-2">
      <ImagePlaceholder label="Pitchfire investor workspace" />
      <ImagePlaceholder
        label="Pitchfire logo"
        aspect="1 / 1"
        class="max-w-48"
      />
    </div>
  </Section>
</BaseLayout>
