---
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import { site } from "../site.config";
---

<BaseLayout
  title={`${site.name} | Software Engineer`}
  description="Portfolio of Kyle Tranfaglia, software engineer and data scientist. Redesign in progress."
>
  <Container class="py-24 sm:py-32">
    <p class="font-mono text-xs tracking-widest text-accent uppercase">
      Redesign in progress
    </p>
    <h1 class="mt-4 text-display font-semibold">{site.name}</h1>
    <p class="mt-4 text-lg text-fg-muted">{site.headline}</p>
  </Container>
</BaseLayout>
