---
import {
  ArrowDownToLine,
  CircleCheck,
  Copy,
  FileText,
  Mail,
  MapPin,
  Send,
} from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import PageHeader from "../components/page/PageHeader.astro";
import BrandIcon from "../components/ui/BrandIcon.astro";
import Button from "../components/ui/Button.astro";
import { github, linkedin } from "../icons/brands";
import { site } from "../site.config";
import { getPage } from "../lib/content";

const page = await getPage("contact");

const field =
  "mt-1.5 block w-full rounded-lg border border-line bg-surface-2 px-3 [[data-theme=light]_&]:bg-surface py-2.5 text-fg placeholder:text-fg-subtle transition-colors hover:border-line-strong focus-visible:border-accent";
const labelClass = "text-sm font-medium text-fg";

const profiles = [
  {
    label: "LinkedIn",
    href: site.socials.linkedin,
    icon: linkedin,
    handle: "in/kyletranfaglia",
  },
  {
    label: "GitHub",
    href: site.socials.github,
    icon: github,
    handle: site.githubUser,
  },
];
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader
    heading={page.heading}
    headline={page.headline}
    intro={page.intro}
  />

  <div class="border-t border-line">
    <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-10 xl:py-24">
      <div class="lg:col-span-7">
        <p class="mb-8 flex items-baseline gap-3 font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase">
          <span class="text-accent" aria-hidden="true">
            01
          </span>{" "}
          Send a Message
        </p>
        <div class="rounded-2xl border border-line bg-surface p-6 sm:p-8">
          <form
            action={`https://formspree.io/f/${site.formspreeId}`}
            method="POST"
            data-contact-form
            class="space-y-5"
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>
                  Name
                </label>
                <input
                  id="name"
                  name="name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Your name"
                  class={field}
                />
              </div>
              <div>
                <label for="email" class={labelClass}>
                  Email
                </label>
                <input
                  id="email"
                  name="email"
                  type="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                  class={field}
                />
              </div>
            </div>
            <div>
              <label for="subject" class={labelClass}>
                Subject{" "}
                <span class="font-normal text-fg-subtle">(optional)</span>
              </label>
              <input
                id="subject"
                name="_subject"
                type="text"
                placeholder="A role, a project, or a question"
                class={field}
              />
            </div>
            <div>
              <label for="message" class={labelClass}>
                Message
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                required
                placeholder="Tell me a bit about what you have in mind."
                class={field}
              ></textarea>
            </div>
            <!-- Honeypot: hidden from people, filled in by bots; Formspree drops those. -->
            <div class="hidden" aria-hidden="true">
              <label for="gotcha">Leave this empty</label>
              <input
                id="gotcha"
                type="text"
                name="_gotcha"
                tabindex="-1"
                autocomplete="off"
              />
            </div>
            <div class="flex flex-wrap items-center gap-4">
              <Button type="submit" size="lg">
                <Send size={16} aria-hidden="true" /> Send message
              </Button>
              <p
                data-form-status
                role="status"
                class="text-sm text-fg-muted data-[state=error]:text-fg"
              ></p>
            </div>
          </form>

          <div
            data-form-success
            hidden
            tabindex="-1"
            class="py-8 text-center outline-none"
          >
            <CircleCheck
              size={36}
              aria-hidden="true"
              class="mx-auto text-accent"
            />
            <h2 class="mt-4 text-xl font-semibold">Message Sent</h2>
            <p class="mt-2 text-fg-muted">
              Thanks for reaching out. I'll get back to you within one business
              day.
            </p>
          </div>
        </div>
      </div>

      <aside
        class="space-y-6 lg:col-span-4 lg:col-start-9"
        aria-label="Other ways to reach me"
      >
        <p class="flex items-baseline gap-3 font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase">
          <span class="text-accent" aria-hidden="true">
            02
          </span>{" "}
          Elsewhere
        </p>
        <div class="rounded-2xl border border-line p-5">
          <p class="flex items-center gap-2 font-mono text-xs text-fg-subtle">
            <Mail size={14} aria-hidden="true" /> Email
          </p>
          <a
            href={`mailto:${site.email}`}
            class="mt-2 block font-medium break-all text-fg underline-offset-4 hover:text-accent hover:underline"
          >
            {site.email}
          </a>
          <button
            type="button"
            data-copy-email={site.email}
            class="mt-3 inline-flex items-center gap-1.5 rounded-md text-sm text-fg-muted transition-colors hover:text-fg"
          >
            <Copy size={14} aria-hidden="true" />
            <span data-copy-label>Copy address</span>
          </button>
        </div>

        <ul class="divide-y divide-line rounded-2xl border border-line">
          {profiles.map((p) => (
            <li>
              <a
                href={p.href}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-3 p-4 transition-colors hover:bg-surface"
              >
                <BrandIcon icon={p.icon} class="text-fg-muted" />
                <span>
                  <span class="block font-medium text-fg">{p.label}</span>
                  <span class="block font-mono text-xs text-fg-subtle">
                    {p.handle}
                  </span>
                </span>
                <span class="sr-only">(opens in a new tab)</span>
              </a>
            </li>
          ))}
        </ul>

        <a
          href={site.files.resume}
          download
          class="flex items-center gap-3 rounded-2xl border border-line p-4 transition-colors hover:bg-surface"
        >
          <FileText size={20} aria-hidden="true" class="text-fg-muted" />
          <span class="flex-1">
            <span class="block font-medium text-fg">Resume</span>
            <span class="block font-mono text-xs text-fg-subtle">
              PDF · one page
            </span>
          </span>
          <ArrowDownToLine
            size={16}
            aria-hidden="true"
            class="text-fg-subtle"
          />
        </a>

        <div class="flex gap-2 px-1 text-sm">
          <MapPin
            size={16}
            aria-hidden="true"
            class="mt-0.5 shrink-0 text-fg-subtle"
          />
          <p>
            <span class="block text-fg-muted">{site.location}</span>
            <span class="block text-fg-subtle">{site.locationNote}</span>
          </p>
        </div>
      </aside>
    </Container>
  </div>
</BaseLayout>

<script>
  import { enhanceContactForm } from "../scripts/contact-form";

  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) enhanceContactForm(form);

  const copy = document.querySelector<HTMLButtonElement>("[data-copy-email]");
  const label = copy?.querySelector("[data-copy-label]");
  copy?.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(copy.dataset.copyEmail ?? "");
      if (label) label.textContent = "Copied";
    } catch {
      if (label) label.textContent = "Copy failed. Select the address above.";
    }
    setTimeout(() => {
      if (label) label.textContent = "Copy address";
    }, 2500);
  });
</script>
