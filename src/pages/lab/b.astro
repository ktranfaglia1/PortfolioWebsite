---
/**
 * Phase 5.5 prototype B: "Commit log". Career drawn as a git branch graph,
 * skills as a contribution-style grid shaded by real usage. Real content
 * throughout; noindex.
 */
import "@fontsource/instrument-serif/latin-400-italic.css";
import { ArrowRight, ArrowUpRight, Download, Mail } from "@lucide/astro";
import { Image } from "astro:assets";
import headshot from "../../assets/images/profile/headshot.jpg";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import AccentText from "../../components/lab/AccentText.astro";
import HeroGlow from "../../components/lab/HeroGlow.astro";
import LabSwitcher from "../../components/lab/LabSwitcher.astro";
import Button from "../../components/ui/Button.astro";
import { site } from "../../site.config";
import {
  getEducation,
  getExperience,
  getPage,
  getProjects,
  getSkillGroups,
} from "../../lib/content";
import { formatMonthYear } from "../../lib/dates";
import {
  intensity,
  laneSegments,
  shortHash,
  skillUsage,
  type GraphEvent,
} from "../../lib/lab";

const home = await getPage("home");
const contact = await getPage("contact");
const featured = await getProjects("featured");
const allProjects = await getProjects();
const [education] = await getEducation();
const work = [
  ...(await getExperience("professional")),
  ...(await getExperience("leadership")),
];
const teaching = await getExperience("teaching");
const skillGroups = await getSkillGroups();

/* ---------------------------- Commit graph ---------------------------- */

const lanes = [
  { name: "work", color: "var(--accent)" },
  { name: "teaching", color: "var(--warm)" },
  { name: "projects", color: "var(--fg-muted)" },
  {
    name: "education",
    color: "color-mix(in oklch, var(--accent) 50%, var(--warm))",
  },
];

interface Row extends GraphEvent {
  title: string;
  meta: string;
  href?: string;
  merge?: boolean;
}

const rows: Row[] = [
  ...work.map((e) => ({
    id: e.id,
    lane: 0,
    date: e.data.start,
    title: e.data.role,
    meta: e.data.org,
  })),
  ...teaching.map((e) => ({
    id: e.id,
    lane: 1,
    date: e.data.start,
    title: e.data.role,
    meta: e.data.org,
  })),
  ...featured.map((p) => ({
    id: p.id,
    lane: 2,
    date: p.data.start,
    title: p.data.title,
    meta: p.data.context ?? p.data.role,
    href: `/projects/${p.id}`,
  })),
];
if (education) {
  const ed = education.data;
  if (ed.end instanceof Date) {
    rows.push({
      id: `${education.id}-graduated`,
      lane: 3,
      date: ed.end,
      title: `Graduated ${ed.distinction ?? ""}`.trim(),
      meta: `${ed.degrees.map((d) => d.name).join(" & ")} · ${ed.school}`,
      merge: true,
    });
  }
  rows.push({
    id: `${education.id}-enrolled`,
    lane: 3,
    date: ed.start,
    title: `Enrolled at ${ed.school}`,
    meta: ed.degrees.map((d) => d.name).join(" & "),
  });
}
rows.sort((a, b) => b.date.getTime() - a.date.getTime());
const segments = laneSegments(rows, lanes.length, [0]);
const firstOfLane = new Set(
  lanes.map((_, lane) => rows.findIndex((r) => r.lane === lane)),
);

const LANE_W = 22;
const DOT_Y = 26;
const graphWidth = lanes.length * LANE_W;
const laneX = (lane: number) => LANE_W / 2 + lane * LANE_W;

/* ----------------------------- Skill grid ----------------------------- */

const skills = skillGroups.flatMap((g) => g.data.items.map((i) => i.name));
const usageSources = [
  ...allProjects.map((p) => p.data.stack),
  ...[...work, ...teaching].map((e) => e.data.skills),
];
const usage = skillUsage(skills, usageSources, {
  SQL: ["MySQL", "PostgreSQL", "SQLite"],
  "PySide/PyQt": ["PySide2", "PySide6", "PyQt5", "PyQt6", "PyQt"],
});
const maxUsage = Math.max(...usage.values());
const levelBg = [
  "var(--surface-2)",
  "color-mix(in oklch, var(--accent) 22%, var(--surface))",
  "color-mix(in oklch, var(--accent) 42%, var(--surface))",
  "color-mix(in oklch, var(--accent) 65%, var(--surface))",
  "var(--accent)",
];
const levelFg = [
  "var(--fg-subtle)",
  "var(--fg)",
  "var(--fg)",
  "var(--fg)",
  "var(--accent-fg)",
];
---

<BaseLayout
  title="Prototype B · Commit log"
  description="Design prototype B for the portfolio redesign."
  noindex
  wide
>
  <LabSwitcher current="b" />

  <!-- Hero -->
  <section class="relative isolate overflow-hidden">
    <HeroGlow />
    <Container class="grid gap-14 pt-16 pb-16 sm:pt-24 lg:grid-cols-12 lg:items-center xl:pt-28 xl:pb-24">
      <div class="lg:col-span-7">
        <p class="font-mono text-sm text-fg-subtle" aria-hidden="true">
          <span class="text-accent">~/kyle</span> $ whoami
        </p>
        <div class="mt-5 flex items-center gap-5">
          <Image
            src={headshot}
            alt={`Portrait of ${site.name}`}
            widths={[96, 160, 240]}
            sizes="5rem"
            loading="eager"
            fetchpriority="high"
            class="size-16 rounded-full object-cover ring-2 ring-accent/40 sm:size-20"
          />
          <h1 class="text-[clamp(2.75rem,1rem+4.6vw,6.5rem)] leading-[0.92] font-semibold tracking-[-0.045em]">
            {home.heading}
          </h1>
        </div>
        {home.headline && (
          <p class="mt-6 text-[clamp(1.625rem,1rem+2vw,3rem)] leading-[1.08] font-medium tracking-[-0.02em] text-fg-muted">
            <AccentText text={home.headline} />
          </p>
        )}
        {home.about[0] && (
          <p class="mt-6 max-w-[60ch] text-lg text-fg-muted">{home.about[0]}</p>
        )}
        <div class="mt-9 flex flex-wrap gap-3">
          <Button href="/projects" size="lg">
            View projects <ArrowRight size={18} aria-hidden="true" />
          </Button>
          <Button href={site.files.resume} variant="secondary" size="lg">
            <Download size={18} aria-hidden="true" /> Resume
            <span class="sr-only">(PDF)</span>
          </Button>
        </div>
      </div>

      <!-- Skill grid -->
      <div class="lg:col-span-5">
        <div class="rounded-2xl border border-line bg-canvas/70 p-5 backdrop-blur sm:p-6">
          <div class="flex items-baseline justify-between gap-4">
            <h2 class="font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase">
              Stack activity
            </h2>
            <p class="font-mono text-xs text-fg-subtle">projects + roles</p>
          </div>
          <ul class="mt-4 grid grid-cols-3 gap-1.5 sm:grid-cols-4 2xl:grid-cols-5">
            {skills.map((s) => {
              const n = usage.get(s) ?? 0;
              const lvl = intensity(n, maxUsage);
              return (
                <li
                  class="rounded-md px-2 py-1.5 font-mono text-[0.6875rem] leading-tight break-words"
                  style={`background:${levelBg[lvl]};color:${levelFg[lvl]}`}
                  title={`${s}: used in ${n} ${n === 1 ? "entry" : "entries"}`}
                >
                  {s}
                  <span class="sr-only">{`, used in ${n} ${n === 1 ? "entry" : "entries"}`}</span>
                </li>
              );
            })}
          </ul>
          <div
            class="mt-4 flex items-center justify-end gap-1.5 font-mono text-[0.6875rem] text-fg-subtle"
            aria-hidden="true"
          >
            Less
            {levelBg.map((bg) => (
              <span class="size-3 rounded-[3px]" style={`background:${bg}`} />
            ))}
            More
          </div>
        </div>
      </div>
    </Container>
  </section>

  <!-- Commit log -->
  <section aria-labelledby="b-log" class="border-t border-line">
    <Container class="py-20 xl:py-28">
      <div class="grid gap-8 lg:grid-cols-12">
        <div class="lg:col-span-3">
          <p class="font-mono text-sm text-fg-subtle" aria-hidden="true">
            $ git log --graph
          </p>
          <h2 id="b-log" class="mt-2 text-3xl font-semibold tracking-tight">
            Career history
          </h2>
          <ul class="mt-6 space-y-2 font-mono text-xs text-fg-muted">
            {lanes.map((l) => (
              <li class="flex items-center gap-2">
                <span
                  class="size-2.5 rounded-full"
                  style={`background:${l.color}`}
                  aria-hidden="true"
                />
                {l.name}
              </li>
            ))}
          </ul>
        </div>

        <ol class="lg:col-span-9">
          {rows.map((r, i) => {
            const lane = lanes[r.lane]!;
            return (
              <li class="group relative grid grid-cols-[auto_1fr] gap-x-4 sm:grid-cols-[auto_5rem_1fr_auto]">
                <div
                  class="relative min-h-14"
                  style={`width:${graphWidth}px`}
                  aria-hidden="true"
                >
                  <svg class="absolute inset-0 h-full w-full overflow-visible">
                    {segments[i]!.map((seg, li) => {
                      const x = laneX(li);
                      const stroke = lanes[li]!.color;
                      if (seg === "full")
                        return (
                          <line
                            x1={x}
                            x2={x}
                            y1="0"
                            y2="100%"
                            stroke={stroke}
                            stroke-width="2"
                          />
                        );
                      if (seg === "top")
                        return (
                          <line
                            x1={x}
                            x2={x}
                            y1="0"
                            y2={DOT_Y}
                            stroke={stroke}
                            stroke-width="2"
                          />
                        );
                      if (seg === "bottom")
                        return (
                          <line
                            x1={x}
                            x2={x}
                            y1={DOT_Y}
                            y2="100%"
                            stroke={stroke}
                            stroke-width="2"
                          />
                        );
                      return null;
                    })}
                    {r.merge && (
                      <path
                        d={`M ${laneX(r.lane)} ${DOT_Y} C ${laneX(r.lane)} ${DOT_Y - 18}, ${laneX(0)} ${DOT_Y - 6}, ${laneX(0)} 0`}
                        fill="none"
                        stroke={lane.color}
                        stroke-width="2"
                      />
                    )}
                    <circle
                      cx={laneX(r.lane)}
                      cy={DOT_Y}
                      r="5.5"
                      fill="var(--canvas)"
                      stroke={lane.color}
                      stroke-width="2.5"
                    />
                  </svg>
                </div>
                <p class="hidden pt-[1.05rem] font-mono text-xs text-fg-subtle sm:block">
                  {shortHash(r.id)}
                </p>
                <div class="py-3.5">
                  <p class="flex flex-wrap items-center gap-2">
                    {i === 0 && (
                      <span class="rounded-full border border-accent/50 px-2 py-0.5 font-mono text-[0.6875rem] text-accent">
                        HEAD
                      </span>
                    )}
                    {firstOfLane.has(i) && (
                      <span
                        class="rounded-full px-2 py-0.5 font-mono text-[0.6875rem] text-fg-muted"
                        style={`border:1px solid ${lane.color}`}
                      >
                        {lane.name}
                      </span>
                    )}
                    {r.merge && (
                      <span class="font-mono text-xs text-fg-subtle">
                        merge:
                      </span>
                    )}
                    {r.href ? (
                      <a
                        href={r.href}
                        class="font-medium text-fg underline-offset-4 hover:text-accent hover:underline"
                      >
                        {r.title}
                      </a>
                    ) : (
                      <span class="font-medium text-fg">{r.title}</span>
                    )}
                  </p>
                  <p class="mt-0.5 text-sm text-fg-muted">{r.meta}</p>
                </div>
                <p class="hidden pt-[1.05rem] text-right font-mono text-xs text-fg-subtle sm:block">
                  {formatMonthYear(r.date)}
                </p>
              </li>
            );
          })}
        </ol>
      </div>
    </Container>
  </section>

  <!-- Pinned projects -->
  <section aria-labelledby="b-pinned" class="border-t border-line">
    <Container class="py-20 xl:py-28">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div>
          <p class="font-mono text-sm text-fg-subtle" aria-hidden="true">
            $ ls ~/projects --pinned
          </p>
          <h2 id="b-pinned" class="mt-2 text-3xl font-semibold tracking-tight">
            Selected work
          </h2>
        </div>
        <a
          href="/projects"
          class="inline-flex items-center gap-1 text-sm font-medium text-accent underline-offset-4 hover:underline"
        >
          All projects <ArrowRight size={14} aria-hidden="true" />
        </a>
      </div>
      <ul class="mt-10 grid gap-4 md:grid-cols-2 2xl:grid-cols-3">
        {featured.map((p) => (
          <li
            class="group relative flex flex-col rounded-2xl border border-line bg-surface/60 p-6 transition-colors hover:border-line-strong"
            data-spotlight
          >
            <div class="flex items-start justify-between gap-4">
              <h3 class="font-mono text-base font-medium text-fg group-hover:text-accent">
                <a
                  href={`/projects/${p.id}`}
                  class="after:absolute after:inset-0"
                >
                  {p.id}
                </a>
              </h3>
              <ArrowUpRight
                size={18}
                aria-hidden="true"
                class="shrink-0 text-fg-subtle group-hover:text-accent"
              />
            </div>
            <p class="mt-1 text-sm font-medium text-fg">{p.data.title}</p>
            <p class="mt-3 text-sm text-fg-muted">{p.data.summary}</p>
            {p.data.outcomes.length > 0 && (
              <dl class="mt-5 flex flex-wrap gap-x-6 gap-y-3">
                {p.data.outcomes.map((o) => (
                  <div>
                    <dt class="sr-only">{o.label}</dt>
                    <dd class="text-xl leading-none font-semibold tracking-tight">
                      {o.value}
                    </dd>
                    <dd
                      class="mt-1 max-w-[14ch] text-[0.6875rem] leading-snug text-fg-subtle"
                      aria-hidden="true"
                    >
                      {o.label}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            <p class="mt-auto pt-5 font-mono text-xs text-fg-subtle">
              {p.data.stack.slice(0, 4).join(" · ")}
            </p>
          </li>
        ))}
      </ul>
    </Container>
  </section>

  <!-- Contact -->
  <section
    aria-labelledby="b-contact"
    class="relative isolate overflow-hidden border-t border-line"
  >
    <HeroGlow class="opacity-70" />
    <Container class="py-24 xl:py-32">
      <p class="font-mono text-sm text-fg-subtle" aria-hidden="true">
        $ git remote add kyle
      </p>
      <h2
        id="b-contact"
        class="mt-4 max-w-[20ch] text-[clamp(2.25rem,1.1rem+4vw,5.75rem)] leading-[0.95] font-semibold tracking-[-0.04em]"
      >
        <AccentText text={contact.headline ?? contact.heading} />
      </h2>
      <p class="mt-6 max-w-[56ch] text-lg text-fg-muted">{contact.intro}</p>
      <div class="mt-10 flex flex-wrap items-center gap-6">
        <Button href="/contact" size="lg">
          <Mail size={18} aria-hidden="true" /> Send a message
        </Button>
        <a
          href={`mailto:${site.email}`}
          class="font-mono text-sm text-fg-muted underline-offset-4 hover:text-fg hover:underline"
        >
          {site.email}
        </a>
      </div>
    </Container>
  </section>
</BaseLayout>
