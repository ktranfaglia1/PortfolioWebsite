---
import {
  ArrowLeft,
  ArrowRight,
  Award,
  ExternalLink,
  FileText,
} from "@lucide/astro";
import { Image } from "astro:assets";
import { render } from "astro:content";
import { github } from "../../icons/brands";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Container from "../../components/layout/Container.astro";
import BrandIcon from "../../components/ui/BrandIcon.astro";
import Button from "../../components/ui/Button.astro";
import ImagePlaceholder from "../../components/ui/ImagePlaceholder.astro";
import HeroGlow from "../../components/ui/HeroGlow.astro";
import Tag from "../../components/ui/Tag.astro";
import { getProjectsWithPages, type Project } from "../../lib/content";
import { formatDateRange } from "../../lib/dates";
import { categoryLabels, neighbors } from "../../lib/projects";

export async function getStaticPaths() {
  const projects = await getProjectsWithPages();
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project, siblings: projects },
  }));
}

interface Props {
  project: Project;
  siblings: Project[];
}

const { project, siblings } = Astro.props;
const d = project.data;
const { Content, headings } = await render(project);
const toc = headings.filter((h) => h.depth === 2);
// A contents list only helps on longer write-ups.
const showToc = toc.length > 2;
const around = neighbors(siblings, project.id);

const facts = [
  { label: "Role", value: d.role },
  {
    label: "Team",
    value: d.teamLabel ?? (d.team ? `${d.team} people` : "Solo"),
  },
  { label: "Timeline", value: formatDateRange(d.start, d.end) },
  d.context && { label: "Context", value: d.context },
].filter((f): f is { label: string; value: string } => Boolean(f));

// A paper link that points at the same place as the repo is shown once.
const showPaper = d.links.paper && d.links.paper !== d.links.repo;
const label = "font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase";
---

<BaseLayout title={d.title} description={d.summary} ogType="article">
  <article>
    <header class="relative isolate overflow-hidden">
      <HeroGlow class="opacity-70" />
      <Container class="pt-10 pb-12 sm:pt-14 xl:pb-16">
        <a
          href="/projects"
          class="inline-flex items-center gap-1.5 rounded-md text-sm text-fg-muted transition-colors hover:text-fg"
        >
          <ArrowLeft size={16} aria-hidden="true" /> All projects
        </a>

        <div class="mt-10 grid gap-10 lg:grid-cols-12 xl:mt-14">
          <div class="lg:col-span-8">
            <p class="font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase">
              {d.categories.map((c) => categoryLabels[c]).join(" · ")}
            </p>
            <h1
              class:list={[
                "mt-4 leading-[0.95] font-semibold tracking-[-0.04em]",
                // Long titles (the Laridae paper) step down so they don't run
                // to four lines.
                d.title.length > 32
                  ? "text-[clamp(2.25rem,1.2rem+2.6vw,4rem)] leading-[1.02]"
                  : "text-[clamp(2.75rem,1.2rem+4.4vw,6.5rem)]",
              ]}
            >
              {d.title}
            </h1>
            <p class="mt-6 max-w-[56ch] text-lg text-fg-muted sm:text-xl">
              {d.summary}
            </p>
            {(d.links.live || d.links.repo || showPaper) && (
              <div class="mt-8 flex flex-wrap gap-3">
                {d.links.live && (
                  <Button href={d.links.live} external>
                    <ExternalLink size={16} aria-hidden="true" /> Live site
                  </Button>
                )}
                {d.links.repo && (
                  <Button href={d.links.repo} variant="secondary" external>
                    <BrandIcon icon={github} size={16} /> Source code
                  </Button>
                )}
                {showPaper && (
                  <Button
                    href={d.links.paper}
                    variant="secondary"
                    external={!d.links.paper!.startsWith("/")}
                  >
                    <FileText size={16} aria-hidden="true" /> Read the paper
                  </Button>
                )}
              </div>
            )}
          </div>

          <dl class="grid grid-cols-2 gap-x-6 gap-y-5 self-end border-t border-line pt-6 lg:col-span-4 lg:grid-cols-1 lg:border-t-0 lg:border-l lg:pt-0 lg:pl-8">
            {facts.map((f) => (
              <div>
                <dt class="font-mono text-xs text-fg-subtle">{f.label}</dt>
                <dd class="mt-0.5 text-fg">{f.value}</dd>
              </div>
            ))}
          </dl>
        </div>

        {d.outcomes.length > 0 && (
          <dl
            class:list={[
              "mt-12 grid grid-cols-2 gap-6 border-y border-line py-8 xl:mt-16",
              d.outcomes.length === 4 ? "lg:grid-cols-4" : "lg:grid-cols-3",
            ]}
            aria-label="Outcomes"
          >
            {d.outcomes.map((o) => (
              <div class="flex flex-col-reverse justify-end">
                <dt class="mt-2 text-sm text-fg-subtle">{o.label}</dt>
                <dd class="text-[clamp(2rem,1.2rem+2vw,3.5rem)] leading-none font-semibold tracking-tight text-fg">
                  {o.value}
                </dd>
              </div>
            ))}
          </dl>
        )}
      </Container>
    </header>

    <Container>
      {d.cover ? (
        <div class="mx-auto max-w-5xl">
          <Image
            src={d.cover.src}
            alt={d.cover.alt}
            widths={[640, 960, 1280, 1600, 2048]}
            sizes="(min-width: 1120px) 1024px, 92vw"
            loading="eager"
            fetchpriority="high"
            class="mx-auto w-full rounded-2xl border border-line shadow-card"
            style={`max-width: ${d.cover.src.width}px`}
          />
        </div>
      ) : (
        <ImagePlaceholder label={`${d.title} screenshot`} />
      )}

      <div class="mt-16 grid gap-12 lg:grid-cols-12 lg:gap-10 xl:mt-24">
        {showToc && (
          <nav
            aria-label="On this page"
            data-toc
            class="hidden lg:col-span-3 lg:block xl:col-span-2"
          >
            <div class="sticky top-24">
              <p class={label}>Contents</p>
              <ol class="mt-4 space-y-2 border-l border-line text-sm">
                {toc.map((h) => (
                  <li>
                    <a
                      href={`#${h.slug}`}
                      class="-ml-px block border-l border-transparent pl-4 text-fg-muted transition-colors hover:border-accent hover:text-fg aria-[current=true]:border-accent aria-[current=true]:text-fg"
                    >
                      {h.text}
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          </nav>
        )}

        <div
          class:list={[
            "prose min-w-0",
            showToc
              ? "lg:col-span-6 xl:col-span-7"
              : "lg:col-span-8 xl:col-span-9",
          ]}
        >
          <Content />
        </div>

        <aside class="space-y-10 lg:col-span-3" aria-label="Project details">
          <section aria-labelledby="stack-title">
            <h2 id="stack-title" class={label}>
              Stack
            </h2>
            <ul class="mt-4 flex flex-wrap gap-1.5">
              {d.stack.map((s) => (
                <li>
                  <Tag>{s}</Tag>
                </li>
              ))}
            </ul>
          </section>

          {d.recognition.length > 0 && (
            <section aria-labelledby="recognition-title">
              <h2
                id="recognition-title"
                class:list={[label, "flex items-center gap-2"]}
              >
                <Award size={14} aria-hidden="true" /> Recognition
              </h2>
              <ul class="mt-4 space-y-2 text-sm text-fg-muted">
                {d.recognition.map((r) => (
                  <li class="border-l-2 border-warm pl-3">{r}</li>
                ))}
              </ul>
            </section>
          )}
        </aside>
      </div>

      {d.gallery.length > 0 && (
        <section aria-labelledby="gallery-title" class="mt-20">
          <h2 id="gallery-title" class="text-2xl font-semibold">
            Gallery
          </h2>
          <div class="mt-6 grid gap-x-4 gap-y-8 sm:grid-cols-2">
            {d.gallery.map((g, i) => (
              <figure
                class:list={[
                  // An odd last image is centered instead of leaving a hole.
                  d.gallery.length % 2 === 1 &&
                    i === d.gallery.length - 1 &&
                    "sm:col-span-2 sm:mx-auto sm:w-[calc(50%-0.5rem)]",
                ]}
              >
                {/* The caption describes the image, so the image itself is decorative. */}
                <Image
                  src={g.src}
                  alt=""
                  widths={[480, 800, 1200]}
                  sizes="(min-width: 640px) 50vw, 100vw"
                  class="w-full rounded-xl border border-line"
                />
                <figcaption class="mt-2 text-sm text-fg-subtle">
                  {g.alt}
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )}
    </Container>
  </article>

  {around && (
    <Container class="mt-24">
      <nav
        aria-label="More projects"
        class="grid gap-4 border-t border-line pt-10 sm:grid-cols-2"
      >
        <a
          href={`/projects/${around.prev.id}`}
          rel="prev"
          class="group rounded-2xl border border-line p-5 transition-colors hover:border-line-strong hover:bg-surface"
        >
          <span class="flex items-center gap-1.5 font-mono text-xs text-fg-subtle">
            <ArrowLeft size={14} aria-hidden="true" /> Previous
          </span>
          <span class="mt-2 block font-medium text-fg">
            {around.prev.data.title}
          </span>
        </a>
        <a
          href={`/projects/${around.next.id}`}
          rel="next"
          class="group rounded-2xl border border-line p-5 text-right transition-colors hover:border-line-strong hover:bg-surface"
        >
          <span class="flex items-center justify-end gap-1.5 font-mono text-xs text-fg-subtle">
            Next <ArrowRight size={14} aria-hidden="true" />
          </span>
          <span class="mt-2 block font-medium text-fg">
            {around.next.data.title}
          </span>
        </a>
      </nav>
    </Container>
  )}
</BaseLayout>

<script>
  import { initToc } from "../../scripts/toc";

  initToc();
</script>
