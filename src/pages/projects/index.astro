---
import { ExternalLink } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import ProjectCard from "../../components/content/ProjectCard.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/layout/Container.astro";
import { getPage, getProjects } from "../../lib/content";
import { categoryLabels, techOptions, type Category } from "../../lib/projects";

const page = await getPage("projects");
const projects = await getProjects();
const featured = projects.filter((p) => p.data.tier === "featured");
const standard = projects.filter((p) => p.data.tier === "standard");
const archive = projects.filter((p) => p.data.tier === "archive");

const categories = (Object.keys(categoryLabels) as Category[]).filter((c) =>
  projects.some((p) => p.data.categories.includes(c)),
);
const techs = techOptions(projects.map((p) => p.data));

const year = (d: Date) => d.getUTCFullYear();
const chip =
  "rounded-full border border-line px-3 py-1.5 text-sm text-fg-muted transition-colors hover:border-line-strong hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent-subtle aria-pressed:text-fg";
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader heading={page.heading} intro={page.intro} />

  <!-- Filter bar: visible from first paint (no layout shift when the script
       runs); hidden for no-JS visitors, who see every project. -->
  <noscript>
    <style>
      [data-filter] {
        display: none !important;
      }
    </style>
  </noscript>
  <Container>
    <div
      data-filter
      class="flex flex-col gap-4 rounded-2xl border border-line bg-surface p-4 sm:flex-row sm:items-center sm:justify-between"
    >
      <div
        role="group"
        aria-label="Filter by category"
        class="flex flex-wrap gap-2"
      >
        <button type="button" class={chip} data-category="" aria-pressed="true">
          All
        </button>
        {categories.map((c) => (
          <button
            type="button"
            class={chip}
            data-category={c}
            aria-pressed="false"
          >
            {categoryLabels[c]}
          </button>
        ))}
      </div>
      <div class="flex items-center gap-2">
        <label for="tech-filter" class="text-sm text-fg-subtle">
          Tech
        </label>
        <select
          id="tech-filter"
          data-tech
          class="h-9 rounded-lg border border-line bg-surface-2 px-2 text-sm text-fg"
        >
          <option value="">Any</option>
          {techs.map((t) => (
            <option value={t}>{t}</option>
          ))}
        </select>
      </div>
    </div>
    <p
      data-filter-status
      role="status"
      class="mt-4 min-h-6 text-sm text-fg-subtle"
    ></p>
    <div
      data-filter-empty
      hidden
      class="mt-6 rounded-2xl border border-dashed border-line-strong p-8 text-center"
    >
      <p class="text-fg-muted">No projects match those filters.</p>
      <button
        type="button"
        data-filter-clear
        class="mt-3 text-sm font-medium text-accent underline-offset-4 hover:underline"
      >
        Clear filters
      </button>
    </div>
  </Container>

  <Section
    id="featured"
    title="Featured"
    class="pt-6 sm:pt-8"
    data-filter-section
  >
    <div class="grid gap-5 md:grid-cols-2">
      {featured.map((p, i) => (
        <ProjectCard project={p} priority={i === 0} />
      ))}
    </div>
  </Section>

  {standard.length > 0 && (
    <Section
      id="more"
      title="More projects"
      class="pt-0 sm:pt-0"
      data-filter-section
    >
      <div class="grid gap-5 md:grid-cols-2">
        {standard.map((p) => (
          <ProjectCard project={p} />
        ))}
      </div>
    </Section>
  )}

  {archive.length > 0 && (
    <Section
      id="archive"
      title="Archive"
      description="Smaller course projects. Source code on GitHub."
      class="pt-0 sm:pt-0"
      data-filter-section
    >
      <div class="relative overflow-x-auto rounded-2xl border border-line">
        <table class="w-full text-left text-sm">
          <caption class="sr-only">Archived projects</caption>
          <thead class="bg-surface-2 font-mono text-xs text-fg-subtle">
            <tr>
              <th scope="col" class="px-4 py-3 font-normal">
                Year
              </th>
              <th scope="col" class="px-4 py-3 font-normal">
                Project
              </th>
              <th
                scope="col"
                class="hidden px-4 py-3 font-normal sm:table-cell"
              >
                Built with
              </th>
              <th scope="col" class="px-4 py-3 font-normal">
                <span class="sr-only">Link</span>
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-line">
            {archive.map((p) => (
              <tr
                data-project
                data-categories={p.data.categories.join(" ")}
                data-stack={JSON.stringify(p.data.stack)}
              >
                <td class="px-4 py-3 align-top font-mono text-xs text-fg-subtle">
                  {year(p.data.start)}
                </td>
                <td class="px-4 py-3 align-top">
                  <p class="font-medium text-fg">{p.data.title}</p>
                  <p class="mt-0.5 text-fg-muted">{p.data.summary}</p>
                </td>
                <td class="hidden px-4 py-3 align-top font-mono text-xs text-fg-muted sm:table-cell">
                  {p.data.stack.join(", ")}
                </td>
                <td class="px-4 py-3 align-top">
                  {p.data.links.repo && (
                    <a
                      href={p.data.links.repo}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex size-8 items-center justify-center rounded-lg text-fg-muted hover:bg-surface-2 hover:text-fg"
                    >
                      <ExternalLink size={16} aria-hidden="true" />
                      <span class="sr-only">{`${p.data.title} source code (opens in a new tab)`}</span>
                    </a>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </Section>
  )}
</BaseLayout>

<script>
  import {
    applyFilter,
    parseFilter,
    serializeFilter,
  } from "../../scripts/project-filter";

  const bar = document.querySelector<HTMLElement>("[data-filter]");
  if (bar) {
    const chips = [
      ...bar.querySelectorAll<HTMLButtonElement>("[data-category]"),
    ];
    const select = bar.querySelector<HTMLSelectElement>("[data-tech]")!;
    const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]")!;
    const items = [...document.querySelectorAll<HTMLElement>("[data-project]")];
    const sections = [
      ...document.querySelectorAll<HTMLElement>("[data-filter-section]"),
    ];

    let state = parseFilter(location.search);
    // Ignore values from the URL that aren't on the page.
    if (!chips.some((c) => c.dataset.category === state.category))
      state.category = "";
    if (![...select.options].some((o) => o.value === state.tech))
      state.tech = "";

    const render = () => {
      chips.forEach((c) =>
        c.setAttribute(
          "aria-pressed",
          String(c.dataset.category === state.category),
        ),
      );
      select.value = state.tech;
      const shown = applyFilter(items, sections, state);
      empty.hidden = shown > 0;
      const filtered = state.category || state.tech;
      status.textContent = filtered
        ? `Showing ${shown} of ${items.length} projects`
        : "";
    };

    const update = () => {
      history.replaceState(
        null,
        "",
        serializeFilter(state) || location.pathname,
      );
      render();
    };

    chips.forEach((c) =>
      c.addEventListener("click", () => {
        state = { ...state, category: c.dataset.category ?? "" };
        update();
      }),
    );
    select.addEventListener("change", () => {
      state = { ...state, tech: select.value };
      update();
    });
    document
      .querySelector("[data-filter-clear]")
      ?.addEventListener("click", () => {
        state = { category: "", tech: "" };
        update();
      });

    render();
  }
</script>
