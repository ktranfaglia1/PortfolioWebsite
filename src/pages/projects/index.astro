---
import { ArrowRight, ArrowUpRight, FileText } from "@lucide/astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/page/PageHeader.astro";
import BrandIcon from "../../components/ui/BrandIcon.astro";
import ProjectRow from "../../components/content/ProjectRow.astro";
import Section from "../../components/ui/Section.astro";
import Container from "../../components/layout/Container.astro";
import { getPage, getProjects } from "../../lib/content";
import { github } from "../../icons/brands";
import {
  categoryCounts,
  categoryLabels,
  languageOptions,
  type Category,
} from "../../lib/projects";

const page = await getPage("projects");
const projects = await getProjects();
const featured = projects.filter((p) => p.data.tier === "featured");
// Everything that isn't featured shares one list, newest first. Standard
// projects have their own page; archive projects link to their source.
const more = projects
  .filter((p) => p.data.tier !== "featured")
  .toSorted((a, b) => b.data.start.getTime() - a.data.start.getTime());

// "Software" covers nearly every project, so it isn't offered as a filter.
const counts = categoryCounts(projects.map((p) => p.data));
const categories = (Object.keys(categoryLabels) as Category[]).filter(
  (c) => c !== "software" && counts[c],
);
const langs = languageOptions(projects.map((p) => p.data));

const chip =
  "inline-flex items-center gap-1.5 rounded-full border border-line px-3 py-1.5 text-sm text-fg-muted transition-colors hover:border-line-strong hover:text-fg aria-pressed:border-accent aria-pressed:bg-accent-subtle aria-pressed:text-fg";
const count = "font-mono text-xs text-fg-subtle";
const groupLabel =
  "w-full font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase sm:w-24 sm:shrink-0";
const iconLink =
  "relative z-10 inline-flex size-8 items-center justify-center rounded-lg text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg";
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader
    heading={page.heading}
    headline={page.headline}
    intro={page.intro}
  />

  <!-- Filter bar: visible from first paint (no layout shift when the script
       runs); hidden for no-JS visitors, who see every project. -->
  <noscript>
    <style>
      [data-filter] {
        display: none !important;
      }
    </style>
  </noscript>
  <Container>
    <div data-filter class="space-y-3 border-y border-line py-4">
      <div
        role="group"
        aria-label="Filter by type"
        class="flex flex-wrap items-center gap-2"
      >
        <span class={groupLabel} aria-hidden="true">
          Type
        </span>
        <button type="button" class={chip} data-category="" aria-pressed="true">
          All <span class={count}>{projects.length}</span>
        </button>
        {categories.map((c) => (
          <button
            type="button"
            class={chip}
            data-category={c}
            aria-pressed="false"
          >
            {categoryLabels[c]} <span class={count}>{counts[c]}</span>
          </button>
        ))}
      </div>
      <div
        role="group"
        aria-label="Filter by language"
        class="flex flex-wrap items-center gap-2"
      >
        <span class={groupLabel} aria-hidden="true">
          Language
        </span>
        <button type="button" class={chip} data-tech="" aria-pressed="true">
          Any
        </button>
        {langs.map((l) => (
          <button
            type="button"
            class={chip}
            data-tech={l.name}
            aria-pressed="false"
          >
            {l.name} <span class={count}>{l.count}</span>
          </button>
        ))}
      </div>
    </div>
    <p
      data-filter-status
      role="status"
      class="mt-4 min-h-6 text-sm text-fg-subtle"
    ></p>
    <div
      data-filter-empty
      hidden
      class="mt-6 rounded-2xl border border-dashed border-line-strong p-8 text-center"
    >
      <p class="text-fg-muted">No projects match those filters.</p>
      <button
        type="button"
        data-filter-clear
        class="mt-3 text-sm font-medium text-accent underline-offset-4 hover:underline"
      >
        Clear filters
      </button>
    </div>
  </Container>

  <Section
    id="featured"
    title="Featured"
    rule={false}
    class="pt-4 sm:pt-6"
    data-filter-section
  >
    <div class="border-b border-line [&>article:first-child]:pt-2">
      {featured.map((p, i) => (
        <ProjectRow project={p} number={i + 1} priority={i === 0} />
      ))}
    </div>
  </Section>

  {more.length > 0 && (
    <Section
      id="more"
      title="More projects"
      description="Smaller builds, coursework, and writing."
      data-filter-section
    >
      <ol class="divide-y divide-line border-y border-line">
        {more.map((p) => {
          const d = p.data;
          const href =
            d.tier === "standard" ? `/projects/${p.id}` : d.links.repo;
          const external = d.tier !== "standard";
          return (
            <li
              data-project
              data-categories={d.categories.join(" ")}
              data-stack={JSON.stringify(d.stack)}
              class="group relative grid gap-x-8 gap-y-1 py-5 sm:grid-cols-[4rem_1fr_4.5rem] lg:grid-cols-[4rem_1fr_16rem_4.5rem]"
            >
              <p class="font-mono text-xs leading-6 text-fg-subtle">
                {d.start.getUTCFullYear()}
              </p>
              <div class="min-w-0">
                <h3 class="font-medium text-fg">
                  <a
                    href={href}
                    {...(external
                      ? { target: "_blank", rel: "noopener noreferrer" }
                      : {})}
                    class="transition-colors after:absolute after:inset-0 group-hover:text-accent"
                  >
                    {d.title}
                    {external ? (
                      <ArrowUpRight
                        size={14}
                        aria-hidden="true"
                        class="ml-1 inline-block align-[-2px] text-fg-subtle group-hover:text-accent"
                      />
                    ) : (
                      <ArrowRight
                        size={14}
                        aria-hidden="true"
                        class="ml-1 inline-block align-[-2px] text-fg-subtle group-hover:text-accent"
                      />
                    )}
                    {external && (
                      <span class="sr-only">(opens in a new tab)</span>
                    )}
                  </a>
                </h3>
                <p class="mt-1 text-sm text-fg-muted">{d.summary}</p>
              </div>
              <p class="hidden font-mono text-xs leading-6 text-fg-muted lg:block">
                {d.stack.join(", ")}
              </p>
              <div class="flex items-start gap-1 sm:justify-end">
                {d.tier === "standard" && d.links.repo && (
                  <a
                    href={d.links.repo}
                    target="_blank"
                    rel="noopener noreferrer"
                    class={iconLink}
                  >
                    <BrandIcon icon={github} size={16} />
                    <span class="sr-only">{`${d.title} source code (opens in a new tab)`}</span>
                  </a>
                )}
                {d.links.paper && (
                  <a href={d.links.paper} class={iconLink}>
                    <FileText size={16} aria-hidden="true" />
                    <span class="sr-only">{`${d.title} paper (PDF)`}</span>
                  </a>
                )}
              </div>
            </li>
          );
        })}
      </ol>
    </Section>
  )}
</BaseLayout>

<script>
  import {
    applyFilter,
    parseFilter,
    serializeFilter,
  } from "../../scripts/project-filter";

  const bar = document.querySelector<HTMLElement>("[data-filter]");
  if (bar) {
    const chips = [
      ...bar.querySelectorAll<HTMLButtonElement>("[data-category]"),
    ];
    const techChips = [
      ...bar.querySelectorAll<HTMLButtonElement>("[data-tech]"),
    ];
    const status = document.querySelector<HTMLElement>("[data-filter-status]")!;
    const empty = document.querySelector<HTMLElement>("[data-filter-empty]")!;
    const items = [...document.querySelectorAll<HTMLElement>("[data-project]")];
    const sections = [
      ...document.querySelectorAll<HTMLElement>("[data-filter-section]"),
    ];

    let state = parseFilter(location.search);
    // Ignore values from the URL that aren't on the page.
    if (!chips.some((c) => c.dataset.category === state.category))
      state.category = "";
    if (!techChips.some((c) => c.dataset.tech === state.tech)) state.tech = "";

    const render = () => {
      chips.forEach((c) =>
        c.setAttribute(
          "aria-pressed",
          String(c.dataset.category === state.category),
        ),
      );
      techChips.forEach((c) =>
        c.setAttribute("aria-pressed", String(c.dataset.tech === state.tech)),
      );
      const shown = applyFilter(items, sections, state);
      empty.hidden = shown > 0;
      const filtered = state.category || state.tech;
      status.textContent = filtered
        ? `Showing ${shown} of ${items.length} projects`
        : "";
    };

    const update = () => {
      history.replaceState(
        null,
        "",
        serializeFilter(state) || location.pathname,
      );
      render();
    };

    chips.forEach((c) =>
      c.addEventListener("click", () => {
        state = { ...state, category: c.dataset.category ?? "" };
        update();
      }),
    );
    techChips.forEach((c) =>
      c.addEventListener("click", () => {
        state = { ...state, tech: c.dataset.tech ?? "" };
        update();
      }),
    );
    document
      .querySelector("[data-filter-clear]")
      ?.addEventListener("click", () => {
        state = { category: "", tech: "" };
        update();
      });

    render();
  }
</script>
