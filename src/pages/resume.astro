---
import { Download, FileText } from "@lucide/astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "../components/layout/Container.astro";
import PageHeader from "../components/page/PageHeader.astro";
import SkillTag from "../components/content/SkillTag.astro";
import Button from "../components/ui/Button.astro";
import { site } from "../site.config";
import {
  getEducation,
  getExperience,
  getPage,
  getProjects,
  getSkillGroups,
} from "../lib/content";
import { formatDateRange } from "../lib/dates";

const page = await getPage("resume");
const professional = await getExperience("professional");
const teaching = await getExperience("teaching");
const featured = await getProjects("featured");

// The resume reads as a record, so both lists run newest first (ties: the
// later end date first). /projects keeps its curated order.
const endTime = (end: Date | "present" | undefined) =>
  end instanceof Date ? end.getTime() : Infinity;
const newestFirst = <
  T extends { data: { start: Date; end?: Date | "present" } },
>(
  a: T,
  b: T,
) =>
  b.data.start.getTime() - a.data.start.getTime() ||
  endTime(b.data.end) - endTime(a.data.end);
const experience = [...professional, ...teaching].toSorted(newestFirst);
const projects = featured.toSorted(newestFirst);
const skillGroups = await getSkillGroups();
const education = await getEducation();

const heading =
  "flex items-baseline gap-3 font-mono text-xs tracking-[0.2em] text-fg-subtle uppercase";
const num = "text-accent";
const row =
  "flex flex-col gap-0.5 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6";
---

<BaseLayout title={page.title} description={page.description}>
  <PageHeader
    heading={page.heading}
    headline={page.headline}
    intro={page.intro}
  >
    <Button href={site.files.resume} download size="lg">
      <Download size={18} aria-hidden="true" /> Download resume
      <span class="sr-only">(PDF)</span>
    </Button>
    <Button href={site.files.transcript} variant="secondary" download size="lg">
      <FileText size={18} aria-hidden="true" /> Download transcript
      <span class="sr-only">(PDF)</span>
    </Button>
  </PageHeader>

  <div class="border-t border-line">
    <Container class="grid gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-10 xl:py-24">
      <div class="space-y-14 lg:col-span-7 xl:col-span-6">
        <section aria-labelledby="r-experience">
          <h2 id="r-experience" class={heading}>
            <span class={num} aria-hidden="true">
              01
            </span>{" "}
            Experience
          </h2>
          <ul class="mt-3 divide-y divide-line">
            {experience.map((e) => (
              <li class={row}>
                <p>
                  <span class="font-medium text-fg">{e.data.role}</span>
                  <span class="text-fg-muted">{` · ${e.data.org}`}</span>
                </p>
                <p class="shrink-0 font-mono text-xs text-fg-subtle">
                  {formatDateRange(e.data.start, e.data.end)}
                </p>
              </li>
            ))}
          </ul>
          <a
            href="/experience"
            class="mt-3 inline-block text-sm font-medium text-accent underline-offset-4 hover:underline"
          >
            Full experience
          </a>
        </section>

        <section aria-labelledby="r-projects">
          <h2 id="r-projects" class={heading}>
            <span class={num} aria-hidden="true">
              02
            </span>{" "}
            Selected Projects
          </h2>
          <ul class="mt-3 divide-y divide-line">
            {projects.map((p) => (
              <li class="py-3">
                <div class="flex flex-col gap-0.5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
                  <a
                    href={`/projects/${p.id}`}
                    class="font-medium text-fg underline-offset-4 hover:text-accent hover:underline"
                  >
                    {p.data.title}
                  </a>
                  <p class="shrink-0 font-mono text-xs text-fg-subtle">
                    {formatDateRange(p.data.start, p.data.end)}
                  </p>
                </div>
                <p class="mt-0.5 font-mono text-xs text-fg-subtle">
                  {p.data.stack.slice(0, 6).join(" · ")}
                </p>
              </li>
            ))}
          </ul>
        </section>

        <section aria-labelledby="r-skills" id="skills">
          <h2 id="r-skills" class={heading}>
            <span class={num} aria-hidden="true">
              03
            </span>{" "}
            Skills
          </h2>
          <div class="mt-4 space-y-5">
            {skillGroups.map((g) => (
              <div>
                <h3 class="text-sm font-medium text-fg">{g.data.label}</h3>
                <ul class="mt-2 flex flex-wrap gap-1.5">
                  {g.data.items.map((i) => (
                    <li>
                      <SkillTag name={i.name} icon={i.icon} glyph={i.glyph} />
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </section>

        <section aria-labelledby="r-education">
          <h2 id="r-education" class={heading}>
            <span class={num} aria-hidden="true">
              04
            </span>{" "}
            Education
          </h2>
          {education.map(({ data: ed }) => (
            <div class="mt-3">
              <div class={row}>
                <p class="font-medium text-fg">{ed.school}</p>
                <p class="shrink-0 font-mono text-xs text-fg-subtle">
                  {formatDateRange(ed.start, ed.end)}
                </p>
              </div>
              <p class="text-fg-muted">
                {[
                  ...ed.degrees.map((d) => d.name),
                  ...ed.minors.map((m) => `Minor in ${m}`),
                ].join(" · ")}
              </p>
              <p class="mt-1 text-sm text-fg-subtle">
                {[`GPA ${ed.gpa}`, ed.distinction].filter(Boolean).join(" · ")}
              </p>
              {ed.honors.length > 0 && (
                <p class="mt-1 text-sm text-fg-subtle">
                  {ed.honors.map((h) => h.title).join(" · ")}
                </p>
              )}
            </div>
          ))}
        </section>
      </div>

      <!-- PDF preview on large screens only; phones get the download buttons. -->
      <div class="hidden lg:col-span-5 lg:block xl:col-span-6">
        <div class="sticky top-24 mx-auto w-fit max-w-full overflow-hidden rounded-2xl border border-line bg-surface shadow-card">
          <iframe
            src={`${site.files.resume}#toolbar=0&navpanes=0&view=Fit&zoom=page-fit`}
            title={`${site.name} resume (PDF preview)`}
            loading="lazy"
            class="block aspect-[8.5/11] h-[calc(100dvh-8rem)] max-w-full"
          ></iframe>
        </div>
      </div>
    </Container>
  </div>
</BaseLayout>
