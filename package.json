    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.13",
    "cmdk": "^1.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "simple-icons": "^16.38.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
